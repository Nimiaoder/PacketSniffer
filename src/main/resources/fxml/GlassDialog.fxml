<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" styleClass="app-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sniffer.GlassDialogController">
    <top>
        <HBox styleClass="title-bar" alignment="CENTER_LEFT">
            <HBox fx:id="dragArea" spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <Label fx:id="iconLabel" styleClass="title-logo" text="ⓘ"/>
                <Label fx:id="titleLabel" styleClass="title-text" text="提示"/>
            </HBox>
            <Button fx:id="closeBtn" styleClass="win-btn" text="&#xE8BB;" focusTraversable="false"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="card" styleClass="glass-card">
            <BorderPane.margin>
                <Insets top="6.0" right="14.0" bottom="6.0" left="14.0"/>
            </BorderPane.margin>
            <TextArea fx:id="messageArea" styleClass="dialog-text" editable="false" wrapText="true"/>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets top="6.0" right="16.0" bottom="14.0" left="16.0"/>
            </padding>
            <Button fx:id="okBtn" styleClass="primary-btn" text="確定" defaultButton="true" onAction="#onOk"/>
        </HBox>
    </bottom>
</BorderPane>
